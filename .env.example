# ---------------------------------------------------------------------------
# Supabase configuration
# ---------------------------------------------------------------------------
# Both values are safe to expose to the browser: they are the *publishable*
# (previously called "anon") credentials and are protected by Row Level
# Security. NEVER put the service-role key here or in any NEXT_PUBLIC_ var.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Supabase now issues publishable keys that look like
# "sb_publishable_..." — copy the value from:
#   Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Media / storage
# ---------------------------------------------------------------------------
# Name of the public Supabase Storage bucket used for property media.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=property-media

# Maximum accepted upload sizes. Keep these aligned with the bucket limits you
# configure in the Supabase dashboard. Values are in bytes.
# Defaults: 10 MB images, 50 MB videos.
NEXT_PUBLIC_MAX_IMAGE_UPLOAD_BYTES=10485760
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: transactional email (NOT required for the site to work)
# ---------------------------------------------------------------------------
# The database-backed inbox works without email. If you want email
# notifications for new inquiries, provide a Resend API key and a verified
# sender address. Leave blank to disable email entirely.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_FROM_EMAIL=
